{
  "name": "@x-arcade/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -b ../shared && next dev --port 3939",
    "//build": "@x-arcade/shared resolves to its dist/, which is gitignored — so on a clean checkout (Vercel, CI, a fresh clone) nothing has built it and every import fails with 'Module not found'. Building the dependency first is the whole fix.",
    "build": "tsc -b ../shared && next build",
    "start": "next start",
    "migrate": "node ../../scripts/migrate.mjs"
  },
  "dependencies": {
    "@x-arcade/shared": "*",
    "next": "^15.1.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
