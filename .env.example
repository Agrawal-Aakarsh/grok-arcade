# Reference for the SERVER's environment variables. Not a required setup step.
#
# Local dev + `npm run smoke` read XAI_API_KEY straight from your shell, exactly
# like grok does — if you've already exported it, there is nothing to do here.
# Copy this to .env.local (gitignored) only if you'd rather not export globally.
#
# On Vercel these go in the dashboard: a serverless function has no shell to
# inherit from, so that is the only mechanism available there.
#
# The key is SERVER-SIDE ONLY and never ships in the npm package. Players who run
# `npx x-arcade` need no key of their own — the server holds one and pays for all
# of them. That is the entire reason there is a server between the CLI and xAI.

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Models
JUDGE_MODEL=grok-4.5
IMAGE_MODEL=grok-imagine-image
TARGET_IMAGE_MODEL=grok-imagine-image-quality

# Jury tuning
JUDGE_VOTES=3
JUDGE_TEMPERATURE=0.6
SCORE_BAR=70

# Cost ceiling — global kill switch across ALL players
MAX_GENERATIONS_PER_DAY=500
