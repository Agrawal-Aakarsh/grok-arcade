# ── secrets ───────────────────────────────────────────────────────────────
# Matches at every depth, so packages/server/.env.local is covered too.
.env
.env.*
!.env.example

# ── dependencies ──────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases

# ── build output ──────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
# Regenerated by `next dev`/`next build` on every run; committing it just
# creates conflicts. This matches create-next-app's own template.
next-env.d.ts

# ── deployment ────────────────────────────────────────────────────────────
.vercel

# ── test + tooling artefacts ──────────────────────────────────────────────
coverage/
.nyc_output/
*.log
npm-debug.log*
yarn-error.log*
.eslintcache

# Generated images from `npm run smoke` — real xAI output, no reason to ship it
.smoke/

# ── editors + os ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
